<script>
const NETWORKS = {
  mtn:    { name: 'MTN Nigeria',     url: 'https://www.mtn.ng',        reward: 2000, required: 90 },
  airtel: { name: 'Airtel Nigeria',  url: 'https://www.airtel.com.ng', reward: 2000, required: 90 },
  glo:    { name: 'Glo (Globacom)',  url: 'https://www.gloworld.com/ng', reward: 2000, required: 90 },
};

let _user = null, _profile = null, _claimed = {};
let _active = null; // { network, requiredMs, startedAt }
let _totalHidden = 0, _hiddenSince = null;

document.addEventListener('DOMContentLoaded', async () => {
  const result = await requireAuth();
  if (!result) return;
  _user = result.user; _profile = result.profile;

  const name = _profile?.full_name || _user.user_metadata?.full_name || 'Grinder';
  document.getElementById('sidebarName').textContent = name;
  document.getElementById('sidebarAvatar').textContent = name.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase();
  document.getElementById('navBalance').textContent = formatNaira(_profile?.balance || 0);

  await loadClaimed();
  renderAll();
});

async function loadClaimed() {
  const sb = getSupabase();
  try {
    const { data } = await sb.from('network_provider_claims').select('network').eq('user_id', _user.id);
    _claimed = {};
    (data || []).forEach(r => { _claimed[r.network] = true; });
  } catch (e) { console.warn('[NetworkBonus] Could not load claims:', e.message); }
}

function renderAll() {
  Object.keys(NETWORKS).forEach(key => renderCard(key));
}

function renderCard(key) {
  const card = document.querySelector(`.network-card[data-network="${key}"]`);
  const slot = document.querySelector(`[data-slot="${key}"]`);
  card.classList.remove('is-active', 'is-claimed');

  if (_claimed[key]) {
    card.classList.add('is-claimed');
    slot.innerHTML = `<div class="claimed-box"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>Bonus already claimed for ${NETWORKS[key].name}</div>`;
  } else if (_active && _active.network === key) {
    card.classList.add('is-active');
    slot.innerHTML = `<div class="waiting-box"><div class="waiting-box__timer" id="timer-${key}">90s</div><div class="waiting-box__label">Stay on ${NETWORKS[key].name}'s site, then come back and click below</div></div><button class="btn btn-go" style="margin-top:.75rem;" onclick="attemptClaim('${key}')">I'm Back — Claim ₦2,000</button>`;
  } else {
    slot.innerHTML = `<button class="btn btn-go" onclick="startVisit('${key}')">Visit ${NETWORKS[key].name.split(' ')[0]} &amp; Start Timer</button>`;
  }
}

function startVisit(key) {
  if (_claimed[key]) { showToast('You already claimed this network\\'s bonus.', 'info'); return; }
  const net = NETWORKS[key];
  window.open(net.url, '_blank', 'noopener,noreferrer');
  _active = { network: key, requiredMs: net.required * 1000, startedAt: Date.now() };
  _totalHidden = 0; _hiddenSince = null;
  renderCard(key);
  showToast(`Opened ${net.name}. Spend at least ${net.required}s there, then come back.`, 'info', 4000);
}

document.addEventListener('visibilitychange', () => {
  if (!_active) return;
  if (document.visibilityState === 'hidden') {
    _hiddenSince = Date.now();
  } else if (_hiddenSince) {
    _totalHidden += Date.now() - _hiddenSince;
    _hiddenSince = null;
  }
});

function attemptClaim(key) {
  if (!_active || _active.network !== key) return;
  const elapsed = _totalHidden + (_hiddenSince ? Date.now() - _hiddenSince : 0);

  if (elapsed < _active.requiredMs) {
    const remaining = Math.ceil((_active.requiredMs - elapsed) / 1000);
    showToast(`You didn't complete the task. Spend at least ${remaining} more second(s) on the site before coming back.`, 'error', 6000);
    _active = null;
    renderCard(key);
    return;
  }

  claimReward(key);
}

async function claimReward(key) {
  const net = NETWORKS[key];
  const sb = getSupabase();

  try {
    const { error } = await sb.from('network_provider_claims').insert({
      user_id: _user.id, network: key, reward: net.reward, created_at: new Date().toISOString(),
    });

    if (error) {
      if (error.code === '23505') { showToast('This bonus was already claimed on this account.', 'warning'); }
      else { throw error; }
    } else {
      const newBalance = (_profile.balance || 0) + net.reward;
      await sb.from('profiles').update({ balance: newBalance }).eq('id', _user.id);
      _profile.balance = newBalance;
      document.getElementById('navBalance').textContent = formatNaira(newBalance);
      showToast(`✅ ${formatNaira(net.reward)} credited for ${net.name}!`, 'success', 6000);
    }
  } catch (e) {
    console.error('[NetworkBonus] Claim failed:', e.message);
    showToast('Could not process claim: ' + e.message, 'error');
  } finally {
    _claimed[key] = true;
    _active = null;
    renderCard(key);
  }
}

// Live countdown display while a timer is active
setInterval(() => {
  if (!_active) return;
  const el = document.getElementById(`timer-${_active.network}`);
  if (!el) return;
  const elapsed = _totalHidden + (_hiddenSince ? Date.now() - _hiddenSince : 0);
  const remaining = Math.max(0, Math.ceil((_active.requiredMs - elapsed) / 1000));
  el.textContent = remaining > 0 ? `${remaining}s` : 'Ready!';
}, 1000);

(function() {
  const btn = document.getElementById('sidebarToggleBtn');
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebarOverlay');
  if (!btn || !sidebar) return;
  function open()  { sidebar.classList.add('sidebar--open'); overlay?.classList.add('active'); document.body.style.overflow = 'hidden'; }
  function close() { sidebar.classList.remove('sidebar--open'); overlay?.classList.remove('active'); document.body.style.overflow = ''; }
  btn.addEventListener('click', () => sidebar.classList.contains('sidebar--open') ? close() : open());
  overlay?.addEventListener('click', close);
  sidebar.querySelectorAll('a').forEach(a => a.addEventListener('click', close));
})();
</script>

