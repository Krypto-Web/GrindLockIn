<style>
:root{
  --paper:#F6F7F2;--paper-dim:#ECEFE7;--white:#FFFFFF;--ink:#0E1F17;--ink-soft:#1B3327;
  --green:#0E7C4A;--green-deep:#0A5C37;--green-pale:#E3F3E9;
  --coral:#FF6B47;--coral-deep:#E5502C;
  --danger:#DC2626;--danger-pale:#FEE2E2;--warning:#D97706;--warning-pale:#FEF3C7;--info:#2563EB;--info-pale:#DBEAFE;
  --line:#D8DDD1;--line-soft:#E4E8DE;--muted:#5B6B60;
  --font-display:'Big Shoulders Display',sans-serif;--font-body:'Plus Jakarta Sans',sans-serif;--font-mono:'IBM Plex Mono',monospace;
  --radius-sm:10px;--radius-md:16px;--radius-lg:24px;--radius-xl:28px;
  --shadow-card:0 2px 4px rgba(14,31,23,.04),0 12px 28px rgba(14,31,23,.07);
  --shadow-lift:0 8px 16px rgba(14,31,23,.06),0 24px 48px rgba(14,31,23,.10);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:var(--font-body);background:var(--paper);color:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased;}
img,svg{display:block;max-width:100%;}
a{color:inherit;text-decoration:none;}
button{font-family:inherit;cursor:pointer;}
h1,h2,h3{font-family:var(--font-display);font-weight:800;letter-spacing:-.01em;}
:focus-visible{outline:3px solid var(--coral);outline-offset:2px;border-radius:4px;}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;font-family:var(--font-body);font-weight:700;font-size:.88rem;padding:.75rem 1.35rem;border-radius:50px;border:2px solid transparent;transition:transform .15s,box-shadow .15s,background .15s,opacity .15s;white-space:nowrap;}
.btn:hover{transform:translateY(-2px);}
.btn:disabled{opacity:.5;pointer-events:none;transform:none;}
@keyframes pulseDot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.35;transform:scale(.8);}}
@keyframes spin{to{transform:rotate(360deg);}}

/* ===== App shell (shared) ===== */
.topbar{position:sticky;top:0;z-index:400;height:64px;background:rgba(246,247,242,.9);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 1.25rem;}
.logo{display:inline-flex;align-items:center;gap:.5rem;font-family:var(--font-display);font-size:1.2rem;font-weight:800;}
.logo svg{width:26px;height:26px;}
.logo .accent{color:var(--green);}
.topbar__right{display:flex;align-items:center;gap:1.1rem;}
.balance-pill{font-size:.78rem;color:var(--muted);}
.balance-pill strong{font-family:var(--font-mono);color:var(--green-deep);}
.menu-btn{display:none;background:none;border:none;color:var(--ink);padding:.4rem;}
@media (max-width:899px){.menu-btn{display:block;}}
.app-shell{display:flex;align-items:flex-start;}
.sidebar{width:258px;flex-shrink:0;background:var(--ink);color:rgba(255,255,255,.82);height:calc(100vh - 64px);position:sticky;top:64px;overflow-y:auto;display:flex;flex-direction:column;justify-content:space-between;transition:transform .25s ease;z-index:390;}
.sidebar__nav{padding:1.5rem 1rem;display:flex;flex-direction:column;gap:.2rem;}
.sidebar__label{font-family:var(--font-mono);font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.35);padding:.6rem .75rem .4rem;}
.sidebar__link{display:flex;align-items:center;gap:.75rem;padding:.68rem .75rem;border-radius:var(--radius-sm);font-size:.87rem;font-weight:600;color:rgba(255,255,255,.72);}
.sidebar__link svg{width:18px;height:18px;flex-shrink:0;}
.sidebar__link:hover{background:rgba(255,255,255,.06);color:#fff;}
.sidebar__link.active{background:var(--green);color:#fff;}
.sidebar__badge{margin-left:auto;font-family:var(--font-mono);font-size:.62rem;font-weight:700;background:rgba(95,214,154,.18);color:#5FD69A;padding:.15rem .45rem;border-radius:20px;}
.sidebar__badge--blue{background:rgba(96,165,250,.18);color:#60A5FA;}
.sidebar__badge--coral{background:rgba(255,107,71,.18);color:#FF9478;}
.sidebar__footer{padding:1rem;border-top:1px solid rgba(255,255,255,.1);}
.sidebar__user{display:flex;align-items:center;gap:.65rem;}
.user-avatar{width:36px;height:36px;border-radius:50%;background:var(--green);color:#fff;font-family:var(--font-mono);font-size:.72rem;font-weight:700;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.sidebar__user-name{font-size:.83rem;font-weight:700;color:#fff;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:120px;}
.sidebar__user-role{font-size:.72rem;color:rgba(255,255,255,.45);}
.sidebar__user-info{flex:1;min-width:0;}
.icon-btn{background:none;border:none;color:rgba(255,255,255,.5);padding:.4rem;flex-shrink:0;}
.icon-btn:hover{color:#fff;}
.icon-btn svg{width:16px;height:16px;}
.sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(14,31,23,.4);z-index:380;}
.sidebar-overlay.active{display:block;}
@media (max-width:899px){.sidebar{position:fixed;top:64px;left:0;transform:translateX(-100%);}.sidebar--open{transform:translateX(0);}}

.main{flex:1;min-width:0;padding:1.75rem 1.5rem 6rem;max-width:820px;}
@media (max-width:640px){.main{padding:1.25rem 1rem 6rem;}}
.page-head{margin-bottom:1.5rem;}
.page-head .eyebrow{font-family:var(--font-mono);font-size:.78rem;color:var(--coral-deep);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem;}
.page-head h1{font-size:1.9rem;text-transform:uppercase;margin-bottom:.4rem;}
.page-head p{color:var(--muted);font-size:.92rem;max-width:560px;}

.info-banner{display:flex;gap:.85rem;align-items:flex-start;padding:1rem 1.25rem;background:var(--info-pale);border:1px solid rgba(37,99,235,.22);border-radius:var(--radius-lg);margin-bottom:1.75rem;}
.info-banner svg{width:20px;height:20px;flex-shrink:0;margin-top:1px;color:var(--info);}
.info-banner div{font-size:.84rem;color:#1E3A8A;line-height:1.6;}
