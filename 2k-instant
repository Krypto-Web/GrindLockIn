.network-grid{display:flex;flex-direction:column;gap:1.1rem;}
.network-card{background:var(--white);border:1.5px solid var(--line);border-radius:var(--radius-xl);overflow:hidden;transition:border-color .18s,box-shadow .18s;}
.network-card.is-active{border-color:var(--net-color);box-shadow:0 0 0 3px color-mix(in srgb, var(--net-color) 15%, transparent);}
.network-card.is-claimed{opacity:.6;}
.network-card__top{display:flex;align-items:center;gap:1rem;padding:1.35rem 1.5rem;}
.network-card__badge{width:52px;height:52px;border-radius:14px;background:var(--net-color);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:800;font-size:1.05rem;flex-shrink:0;}
.network-card__name{font-weight:800;font-size:1.05rem;}
.network-card__site{font-size:.78rem;color:var(--muted);}
.network-card__reward{margin-left:auto;text-align:right;flex-shrink:0;}
.network-card__reward-val{font-family:var(--font-mono);font-size:1.3rem;font-weight:700;color:var(--net-color);}
.network-card__reward-label{font-size:.68rem;color:var(--muted);}
.network-card__bottom{padding:0 1.5rem 1.35rem;}
.network-card .btn-go{background:var(--net-color);color:#fff;width:100%;}
.network-card .btn-go:hover{filter:brightness(0.9);}
.waiting-box{background:var(--paper-dim);border:1px dashed var(--net-color);border-radius:var(--radius-md);padding:1rem;text-align:center;}
.waiting-box__timer{font-family:var(--font-mono);font-size:1.4rem;font-weight:700;color:var(--net-color);margin-bottom:.3rem;}
.waiting-box__label{font-size:.78rem;color:var(--ink-soft);}
.claimed-box{display:flex;align-items:center;gap:.6rem;background:var(--green-pale);color:var(--green-deep);border-radius:var(--radius-md);padding:.9rem 1rem;font-size:.85rem;font-weight:700;}
.claimed-box svg{width:18px;height:18px;flex-shrink:0;}

#gp-toast-container{position:fixed;top:1.25rem;right:1.25rem;z-index:1000;display:flex;flex-direction:column;gap:.6rem;max-width:min(360px,calc(100vw - 2.5rem));}
.gp-toast{display:flex;align-items:flex-start;gap:.6rem;background:var(--white);border:1px solid var(--line);border-radius:var(--radius-sm);padding:.85rem 1rem;box-shadow:var(--shadow-lift);opacity:0;transform:translateX(16px);transition:opacity .25s,transform .25s;}
.gp-toast--visible{opacity:1;transform:translateX(0);}
.gp-toast--hiding{opacity:0;transform:translateX(16px);}
.gp-toast__icon{width:20px;height:20px;flex-shrink:0;}
.gp-toast__icon svg{width:20px;height:20px;}
.gp-toast__message{font-size:.86rem;flex:1;line-height:1.5;}
.gp-toast__close{background:none;border:none;color:var(--muted);flex-shrink:0;padding:.15rem;}
.gp-toast__close svg{width:15px;height:15px;}
.gp-toast--success .gp-toast__icon{color:var(--green);}
.gp-toast--error .gp-toast__icon{color:var(--danger);}
.gp-toast--warning .gp-toast__icon{color:var(--warning);}
.gp-toast--info .gp-toast__icon{color:var(--muted);}

.telegram-float{position:fixed;bottom:1.5rem;right:1.5rem;z-index:600;display:flex;align-items:center;gap:.5rem;background:#26A5E4;color:#fff;padding:.85rem;border-radius:50px;box-shadow:0 8px 20px rgba(38,165,228,.35);transition:padding .2s ease;}
.telegram-float svg{width:22px;height:22px;flex-shrink:0;}
.telegram-float__label{max-width:0;overflow:hidden;white-space:nowrap;font-size:.85rem;font-weight:700;transition:max-width .2s ease;}
.telegram-float:hover{padding:.85rem 1.1rem;}
.telegram-float:hover .telegram-float__label{max-width:140px;margin-left:.15rem;}
</style>
